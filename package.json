{
  "name": "mcp--inspector",
  "displayName": "MCP Inspector",
  "publisher": "DhananjaySenday",
  "icon": "resources/icon-black.png",
  "description": "Easily inspect and interact with MCP servers directly from Visual Studio Code—no need to download external inspectors. This extension provides seamless integration for monitoring and debugging MCP protocols within your development environment",
  "version": "0.9.0",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dhananjay-JSR/mcp-inspector"
  },
  "author": {
    "email": "hello@dhananjaay.dev",
    "url": "https://dhananjaay.dev",
    "name": "Dhananjay Senday"
  },
  "engines": {
    "vscode": "^1.98.0",
    "node": ">=22.14.0"
  },
  "categories": [
    "Other",
    "AI",
    "Debuggers",
    "Testing"
  ],
  "keywords": [
    "mcp",
    "model context protocol",
    "mcp server",
    "mcp client",
    "inspector",
    "debugging",
    "tools",
    "ai",
    "llm",
    "agent",
    "oauth",
    "sse",
    "streamable http",
    "remote server"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mcp--inspector.createNewRequest",
        "title": "Create New MCP Request"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcp--inspector",
          "title": "MCP Inspector",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "mcp--inspector": [
        {
          "id": "mcp--inspector.inspector-view",
          "name": "Inspector",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "MCP Inspector",
      "properties": {
        "mcp--inspector.tls.caFile": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to a PEM certificate authority bundle used to verify the MCP server. Use this for server certificates signed by a private CA. Desktop app only; the browser controls TLS in VS Code for the Web."
        },
        "mcp--inspector.tls.clientCertFile": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to a PEM client certificate presented to servers that require mutual TLS (mTLS). Must be set together with `#mcp--inspector.tls.clientKeyFile#`. Desktop app only."
        },
        "mcp--inspector.tls.clientKeyFile": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the PEM private key for `#mcp--inspector.tls.clientCertFile#`. The key is read from disk at connect time and is never stored in settings. Desktop app only."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "yarn run compile && yarn run package-node && yarn run package-web",
    "bundle": "node esbuild.node.mjs",
    "package-node": "node esbuild.node.mjs --production",
    "compile": "tsc -p ./",
    "compile-web": "node esbuild.web.mjs",
    "compile-web-tests": "node esbuild.web-test.mjs",
    "watch": "tsc -watch -p ./",
    "watch-web": "node esbuild.web.mjs --watch",
    "package-web": "node esbuild.web.mjs --production",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src",
    "lint:commits": "commitlint --from origin/main --to HEAD --verbose",
    "test": "vscode-test",
    "test:web": "yarn run compile-web && yarn run compile-web-tests && vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web-test/suite/index.js",
    "package": "vsce package",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.98.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.1.0",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "undici": "^8.12.3"
  }
}
