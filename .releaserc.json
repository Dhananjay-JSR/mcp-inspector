{
  "branches": [
    "main"
  ],
  "tagFormat": "v${version}",
  "repositoryUrl": "https://github.com/Dhananjay-JSR/mcp-inspector.git",
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/release-notes-generator",
      {
        "preset": "conventionalcommits"
      }
    ],
    [
      "@semantic-release/changelog",
      {
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/npm",
      {
        "npmPublish": false
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "mkdir -p dist && yarn vsce package --out \"dist/mcp-inspector-${nextRelease.version}.vsix\"",
        "publishCmd": "if [ \"$VSCE_PUBLISH\" = \"true\" ]; then yarn vsce publish --oidc --packagePath \"dist/mcp-inspector-${nextRelease.version}.vsix\"; elif [ -n \"$VSCE_PAT\" ]; then yarn vsce publish --packagePath \"dist/mcp-inspector-${nextRelease.version}.vsix\"; else echo 'Marketplace publishing is not configured, skipping'; fi"
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "CHANGELOG.md",
          "package.json"
        ],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "dist/mcp-inspector-*.vsix",
            "label": "MCP Inspector VSIX"
          }
        ]
      }
    ]
  ]
}
